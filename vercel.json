{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/php-site/assets/$1"
    },
    {
      "src": "/index\\.php",
      "dest": "/index.html"
    },
    {
      "src": "/index\\.html",
      "dest": "/index.html"
    },
    {
      "src": "/menu\\.php",
      "dest": "/menu.html"
    },
    {
      "src": "/menu\\.html",
      "dest": "/menu.html"
    },
    {
      "src": "/checkout\\.php",
      "dest": "/checkout.html"
    },
    {
      "src": "/checkout\\.html",
      "dest": "/checkout.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
